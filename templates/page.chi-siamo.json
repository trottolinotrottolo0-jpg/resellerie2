      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "\n<style>\n.rlr-about-hero{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;max-width:1200px;margin:0 auto;padding:64px 20px;}\n@media(max-width:849px){.rlr-about-hero{grid-template-columns:1fr;padding:40px 20px;}}\n.rlr-about-hero-text .rlr-eyebrow{color:#8a9bb0;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 14px;font-weight:600;}\n.rlr-about-hero-text h1{font-family:var(--font-heading--family,serif);color:#1c3a56;font-size:2.6rem;line-height:1.2;margin:0 0 20px;}\n.rlr-about-hero-text p{color:#5c7186;font-size:1.05rem;line-height:1.7;margin:0 0 14px;}\n.rlr-about-hero-img img{width:100%;border-radius:8px;display:block;object-fit:cover;aspect-ratio:4/3;}\n\n.rlr-about-story{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;max-width:1200px;margin:0 auto;padding:64px 20px;}\n@media(max-width:849px){.rlr-about-story{grid-template-columns:1fr;padding:40px 20px;}}\n.rlr-about-story-img img{width:100%;border-radius:8px;display:block;object-fit:cover;aspect-ratio:4/3;}\n.rlr-about-story-text .rlr-eyebrow{color:#8a9bb0;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 14px;font-weight:600;}\n.rlr-about-story-text h2{font-family:var(--font-heading--family,serif);color:#1c3a56;font-size:1.9rem;margin:0 0 18px;}\n.rlr-about-story-text p{color:#5c7186;font-size:1.02rem;line-height:1.75;margin:0 0 14px;}\n\n.rlr-about-values{background:#f7fafc;padding:56px 20px;}\n.rlr-about-values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;max-width:1200px;margin:0 auto;text-align:center;}\n@media(max-width:849px){.rlr-about-values-grid{grid-template-columns:repeat(2,1fr);}}\n@media(max-width:520px){.rlr-about-values-grid{grid-template-columns:1fr;}}\n.rlr-about-value svg{width:30px;height:30px;stroke:#1c3a56;margin:0 auto 16px;display:block;}\n.rlr-about-value h4{color:#1c3a56;font-size:.95rem;letter-spacing:.03em;text-transform:uppercase;margin:0 0 10px;}\n.rlr-about-value p{color:#5c7186;font-size:.9rem;line-height:1.55;margin:0;}\n\n.rlr-about-commit{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;max-width:1200px;margin:0 auto;padding:72px 20px;}\n@media(max-width:849px){.rlr-about-commit{grid-template-columns:1fr;padding:40px 20px;}}\n.rlr-about-commit-text .rlr-eyebrow{color:#8a9bb0;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 14px;font-weight:600;}\n.rlr-about-commit-text h2{font-family:var(--font-heading--family,serif);color:#1c3a56;font-size:1.9rem;line-height:1.25;margin:0 0 18px;}\n.rlr-about-commit-text p{color:#5c7186;font-size:1.02rem;line-height:1.75;margin:0 0 22px;}\n.rlr-about-commit-text a{color:#1c3a56;font-weight:600;text-decoration:none;font-size:.95rem;}\n.rlr-about-commit-text a:hover{text-decoration:underline;}\n.rlr-about-commit-imgs{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\n.rlr-about-commit-imgs img{width:100%;height:100%;border-radius:8px;display:block;object-fit:cover;aspect-ratio:1;}\n\n.rlr-about-trust{background:#1c3a56;padding:32px 20px;}\n.rlr-about-trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;max-width:1200px;margin:0 auto;text-align:center;}\n@media(max-width:849px){.rlr-about-trust-grid{grid-template-columns:repeat(2,1fr);}}\n.rlr-about-trust-item{color:#cfdcea;font-size:.85rem;}\n.rlr-about-trust-item strong{display:block;color:#fff;font-size:.92rem;margin-bottom:4px;}\n</style>\n\n<div class=\"rlr-about-hero\">\n  <div class=\"rlr-about-hero-text\">\n    <p class=\"rlr-eyebrow\">Chi siamo</p>\n    <h1>Oggetti che raccontano storie senza tempo</h1>\n    <p>Resellerie nasce dalla passione per il vintage autentico e per la bellezza che dura.</p>\n    <p>Selezioniamo con cura oggetti unici e fuori dal tempo, per dare loro una seconda vita e portarli nelle case di chi sa riconoscerne il valore.</p>\n  </div>\n  <div class=\"rlr-about-hero-img\">\n    <img src=\"{{ '01_Hero_Desktop.png' | asset_url }}\" alt=\"Resellerie\">\n  </div>\n</div>\n\n<div class=\"rlr-about-story\">\n  <div class=\"rlr-about-story-img\">\n    <img src=\"{{ '05_Casa_Vintage.png' | asset_url }}\" alt=\"La nostra storia\">\n  </div>\n  <div class=\"rlr-about-story-text\">\n    <p class=\"rlr-eyebrow\">La nostra storia</p>\n    <h2>Tutto è iniziato da una piccola passione diventata nel tempo uno stile di vita.</h2>\n    <p>Giriamo mercatini, botteghe e collezioni private alla ricerca di pezzi speciali, oggetti che parlano di epoche passate e di mani che li hanno creati.</p>\n    <p>Ogni articolo viene scelto con attenzione, pulito, curato e fotografato per essere proposto a chi ama il bello autentico e sostenibile.</p>\n  </div>\n</div>\n\n<div class=\"rlr-about-values\">\n  <div class=\"rlr-about-values-grid\">\n    <div class=\"rlr-about-value\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\"><path d=\"M11 20A7 7 0 0 1 4 13V7a1 1 0 0 1 1-1h4a7 7 0 0 1 7 7v1a5 5 0 0 1-5 5Z\"/><path d=\"M11 20v-9\"/></svg><h4>Selezione curata</h4><p>Oggetti scelti uno ad uno con occhio attento ai dettagli e alla qualità.</p></div>\n    <div class=\"rlr-about-value\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"/><path d=\"M3.3 7 12 12l8.7-5\"/><path d=\"M12 22V12\"/></svg><h4>Imballaggio sicuro</h4><p>Ogni ordine viene imballato con cura per garantirti la massima protezione.</p></div>\n    <div class=\"rlr-about-value\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"/></svg><h4>Passione autentica</h4><p>Amiamo ciò che facciamo e crediamo nel valore delle cose che durano.</p></div>\n    <div class=\"rlr-about-value\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\"><path d=\"M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5\"/><path d=\"M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12\"/><path d=\"m14 16-3 3 3 3\"/><path d=\"M8.293 13.596 7.196 9.5l4.096-1.096\"/><path d=\"m14.394 5.5 4.096 1.096-1.096 4.096\"/><path d=\"M9 5.5H8.815a1.83 1.83 0 0 0-1.596.9L5.196 9.5\"/></svg><h4>Sostenibilità</h4><p>Diamo nuova vita agli oggetti, riducendo gli sprechi e rispettando il pianeta.</p></div>\n  </div>\n</div>\n\n<div class=\"rlr-about-commit\">\n  <div class=\"rlr-about-commit-text\">\n    <p class=\"rlr-eyebrow\">Il nostro impegno</p>\n    <h2>Valorizzare il passato, ispirare il presente</h2>\n    <p>Crediamo che ogni oggetto abbia un'anima. Il nostro impegno è far sì che queste storie continuino attraverso di te, nella tua casa, nel tuo stile, nella tua quotidianità.</p>\n    <a href=\"/collections/all\">Scopri la nostra collezione &rarr;</a>\n  </div>\n  <div class=\"rlr-about-commit-imgs\">\n    <img src=\"{{ '08_Pezzi_Unici.png' | asset_url }}\" alt=\"Pezzi unici\">\n    <img src=\"{{ '09_Best_Seller.png' | asset_url }}\" alt=\"Best seller\">\n  </div>\n</div>\n\n<div class=\"rlr-about-trust\">\n  <div class=\"rlr-about-trust-grid\">\n    <div class=\"rlr-about-trust-item\"><strong>Spedizione veloce</strong>in tutta Italia</div>\n    <div class=\"rlr-about-trust-item\"><strong>Pagamenti sicuri</strong>100% protetti</div>\n    <div class=\"rlr-about-trust-item\"><strong>Resi semplici</strong>entro 14 giorni</div>\n    <div class=\"rlr-about-trust-item\"><strong>Assistenza dedicata</strong>siamo qui per te</div>\n  </div>\n</div>\n",
