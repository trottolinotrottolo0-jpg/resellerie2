{
  "sections": {
    "main": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "\n<style>\n.rlr-contact-wrap{max-width:640px;margin:0 auto;padding:64px 20px;}\n.rlr-contact-wrap h1{font-family:var(--font-heading--family,serif);color:#1c3a56;font-size:2.2rem;margin:0 0 12px;text-align:center;}\n.rlr-contact-intro{color:#5c7186;text-align:center;margin:0 0 40px;line-height:1.6;}\n\n.rlr-contact-form{display:flex;flex-direction:column;gap:16px;}\n.rlr-contact-row{display:flex;flex-direction:column;gap:16px;}\n@media(min-width:750px){.rlr-contact-row{flex-direction:row;}}\n.rlr-contact-input{width:100%;padding:14px 18px;border-radius:4px;border:1px solid #cfdcea;background:#fff;color:#1c3a56;font-size:.95rem;font-family:inherit;}\n.rlr-contact-input::placeholder{color:#8a9bb0;}\ntextarea.rlr-contact-input{resize:vertical;min-height:140px;}\n.rlr-contact-submit{align-self:flex-start;padding:14px 32px;background:#1c3a56;color:#fff;border:none;border-radius:4px;font-size:.85rem;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;}\n.rlr-contact-submit:hover{background:#142a40;}\n.rlr-contact-success{background:#e8f3ea;color:#2c6e3f;padding:16px 20px;border-radius:4px;margin-bottom:16px;}\n.rlr-contact-error{background:#fbeaea;color:#a33;padding:16px 20px;border-radius:4px;margin-bottom:16px;}\n\n.rlr-contact-gate{max-width:560px;margin:0 auto;padding:64px 20px;text-align:center;}\n.rlr-contact-gate h1{font-family:var(--font-heading--family,serif);color:#1c3a56;font-size:2rem;margin:0 0 18px;}\n.rlr-contact-gate p{color:#5c7186;line-height:1.7;margin:0 0 14px;}\n.rlr-contact-gate .rlr-gate-box{background:#f7fafc;border-radius:8px;padding:32px 28px;margin:28px 0;}\n.rlr-contact-gate-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:24px;}\n.rlr-contact-gate-btn{display:inline-block;padding:13px 28px;border-radius:4px;font-size:.85rem;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;}\n.rlr-contact-gate-btn--primary{background:#1c3a56;color:#fff;}\n.rlr-contact-gate-btn--primary:hover{background:#142a40;}\n.rlr-contact-gate-btn--secondary{background:transparent;color:#1c3a56;border:1px solid #1c3a56;}\n.rlr-contact-gate-btn--secondary:hover{background:#eef2f6;}\n</style>\n\n{% liquid\n  assign spent = 0\n  if customer\n    assign spent = customer.total_spent | plus: 0\n  endif\n  assign can_contact = false\n  if customer and spent >= 50\n    assign can_contact = true\n  endif\n%}\n\n{% if can_contact %}\n<div class=\"rlr-contact-wrap\">\n  <h1>Contattaci</h1>\n  <p class=\"rlr-contact-intro\">Scrivici pure, ti risponderemo il prima possibile.</p>\n\n  {%- form 'contact', id: 'ContactFormGated', class: 'rlr-contact-form' -%}\n    {%- if form.errors -%}\n      <div class=\"rlr-contact-error\">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>\n    {%- endif -%}\n    {%- if form.posted_successfully? -%}\n      <div class=\"rlr-contact-success\">Messaggio inviato! Ti risponderemo il prima possibile.</div>\n    {%- endif -%}\n\n    <div class=\"rlr-contact-row\">\n      <input type=\"text\" class=\"rlr-contact-input\" autocomplete=\"name\" name=\"contact[name]\" value=\"{% if form.name %}{{ form.name }}{% else %}{{ customer.name }}{% endif %}\" placeholder=\"Nome\">\n      <input type=\"email\" class=\"rlr-contact-input\" autocomplete=\"email\" name=\"contact[email]\" value=\"{% if form.email %}{{ form.email }}{% else %}{{ customer.email }}{% endif %}\" placeholder=\"Email\" required>\n    </div>\n    <input type=\"tel\" class=\"rlr-contact-input\" autocomplete=\"tel\" name=\"contact[phone]\" value=\"{% if form.phone %}{{ form.phone }}{% else %}{{ customer.phone }}{% endif %}\" placeholder=\"Telefono (opzionale)\">\n    <textarea rows=\"8\" class=\"rlr-contact-input\" name=\"contact[body]\" placeholder=\"Il tuo messaggio\">{{ form.body }}</textarea>\n    <button type=\"submit\" class=\"rlr-contact-submit\">Invia</button>\n  {%- endform -%}\n</div>\n{% else %}\n<div class=\"rlr-contact-gate\">\n  <h1>Contattaci</h1>\n  {% if customer %}\n    <p>Il modulo di contatto è riservato ai clienti registrati con almeno 50€ di acquisti sul sito.</p>\n    <div class=\"rlr-gate-box\">\n      <p>Il tuo account non raggiunge ancora questa soglia. Continua a fare acquisti per sbloccare il modulo di contatto.</p>\n    </div>\n  {% else %}\n    <p>Per contattarci tramite questo modulo devi avere un account cliente registrato con almeno 50€ di acquisti sul sito.</p>\n    <div class=\"rlr-gate-box\">\n      <p>Se sei già cliente, accedi al tuo account qui sotto.</p>\n    </div>\n  {% endif %}\n  {% unless customer %}\n    <div class=\"rlr-contact-gate-actions\">\n      <a href=\"{{ routes.account_login_url }}\" class=\"rlr-contact-gate-btn rlr-contact-gate-btn--primary\">Accedi</a>\n    </div>\n  {% endunless %}\n</div>\n{% endif %}\n",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {}
    }
  },
  "order": [
    "main"
  ]
}