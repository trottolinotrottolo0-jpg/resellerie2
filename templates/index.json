ding:0 20px;\n  overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:20px;-webkit-overflow-scrolling:touch;}\n.rlr-review-carousel::-webkit-scrollbar{height:6px;}\n.rlr-review-carousel::-webkit-scrollbar-thumb{background:#1c3a56;border-radius:3px;opacity:.3;}\n.rlr-review-card{flex:0 0 260px;scroll-snap-align:start;background:#fff;border-radius:6px;\n  padding:22px 20px;text-align:left;box-shadow:0 1px 4px rgba(28,58,86,.08);}\n@media(max-width:599px){.rlr-review-card{flex-basis:80vw;}}\n.rlr-review-stars{color:#e8c07d;font-size:.9rem;letter-spacing:2px;margin-bottom:8px;}\n.rlr-review-card p{color:#3a4a5a;font-size:.92rem;line-height:1.5;margin:0 0 10px;min-height:40px;}\n.rlr-review-author{color:#5c7186;font-size:.78rem;font-weight:600;}\n</style>\n\n<div class=\"rlr-hero\">\n  <a href=\"/collections/nuovi-arrivi\">\n    <picture>\n      <source media=\"(max-width: 749px)\" srcset=\"{{ '02_Hero_Mobile.png' | asset_url }}\">\n      <img src=\"{{ '01_Hero_Desktop.png' | asset_url }}\" alt=\"Resellerie - Tesori scelti per una nuova storia\" loading=\"eager\">\n    </picture>\n  </a>\n  <div class=\"rlr-hero__cta\">\n    <a href=\"/collections/nuovi-arrivi\" class=\"rlr-btn\">Scopri i nuovi arrivi</a>\n  </div>\n</div>\n",
